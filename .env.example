# PaperPilot — Firebase Web App Environment Variables
# Copy these into .env.local and populate with your Firebase console web credentials.
# Do NOT commit .env.local to version control.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: per-file upload limit shown in the UI (MB). The server enforces its own limit
# via PAPERPILOT_MAX_UPLOAD_MB (default 25).
# VITE_MAX_UPLOAD_MB=25

# ---------------------------------------------------------------------------------------------
# Backend (FastAPI). Set these in backend/.env locally (git-ignored, loaded automatically) or in the
# host's environment settings (Render). Never in a VITE_ variable and never in Git.
# ---------------------------------------------------------------------------------------------
# Research Mentor: Gemini API key from https://aistudio.google.com/apikey  (REQUIRED for the chatbot)
# GEMINI_API_KEY=your-key-here
# Model that answers questions. Run `python -m backend.check_gemini` to find one that works for your key.
# GEMINI_MODEL=<a model that check_gemini reports as working>
# Optional second model tried once if the first is overloaded or unavailable.
# GEMINI_FALLBACK_MODEL=<another model that check_gemini reports as working>
# Embeddings for paper search: "gemini" (no torch; use this on a small host) or "local" (MiniLM, needs
# backend/requirements-ml.txt). Unset = local when sentence-transformers is installed, else gemini.
# EMBEDDING_BACKEND=gemini
# Firebase project the ID tokens are checked against (defaults to VITE_FIREBASE_PROJECT_ID / the project in code).
# FIREBASE_PROJECT_ID=your-firebase-project-id
# Comma-separated browser origins allowed to call the API. Unset = any origin (development only).
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# Directory for the SQLite database and uploaded PDFs. Point it at a persistent disk in production
# (for example a Render disk mounted at /var/data), otherwise data is lost on every redeploy/restart.
# PAPERPILOT_DATA_DIR=/var/data
# Per-file upload limit in MB (default 25).
# PAPERPILOT_MAX_UPLOAD_MB=25
