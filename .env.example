# PaperPilot — Firebase Web App Environment Variables
# Copy these into .env.local and populate with your Firebase console web credentials.
# Do NOT commit .env.local to version control.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: per-file upload limit shown in the UI (MB). The server enforces its own limit
# via PAPERPILOT_MAX_UPLOAD_MB (default 25).
# VITE_MAX_UPLOAD_MB=25
